#!/bin/bash
# Auto-refresh bloch persistent memory after every commit.
# Installed to .git/hooks/post-commit (see scripts/hooks/install.sh).
set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 1. Refresh the machine-readable codebase map (always).
if [ -x "$HOME/.cargo/bin/bloch" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
    bloch . --update-memory 2>/dev/null || true
    # Stage the refreshed map if it changed (amend into the commit quietly).
    if ! git diff --quiet -- .ai/memory/bloch-last.json .ai/memory/bloch-summary.md 2>/dev/null; then
        git add .ai/memory/bloch-last.json .ai/memory/bloch-summary.md
        git commit --amend --no-edit --no-verify -q 2>/dev/null || true
    fi
fi

# 2. Remind about curated memory files.
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -q "^\.ai/memory/\(todo-tracking\|handoff\)\.md$"; then
    echo ""
    echo "  MEMORY CHECK: this commit did not touch .ai/memory/todo-tracking.md"
    echo "  or .ai/memory/handoff.md. If the work changed project state,"
    echo "  update them: what was done, issue numbers closed, dates."
    echo ""
fi
