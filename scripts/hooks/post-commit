#!/bin/bash
# Post-commit housekeeping for light-show.
# Installed to .git/hooks/post-commit (see scripts/hooks/install.sh).
#
# NOTE (2026-10-08): the bloch codebase map (.ai/memory/bloch-last.json
# and .ai/memory/bloch-summary.md) is a LOCAL artifact only. This hook
# used to refresh it after every commit and amend it into the commit;
# that made two generated files ride along in unrelated commits,
# collide on rebases, and churn ~19k lines through diffs. They are now
# untracked and gitignored. Regenerate on demand with:
#     bloch . --update-memory
# (or run `bloch .` to print a fresh map without writing files).

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Remind about curated memory files.
if ! git diff-tree --no-commit-id --name-only -r HEAD | grep -q "^\.ai/memory/\(todo-tracking\|handoff\)\.md$"; then
    echo ""
    echo "  MEMORY CHECK: this commit did not touch .ai/memory/todo-tracking.md"
    echo "  or .ai/memory/handoff.md. If the work changed project state,"
    echo "  update them: what was done, issue numbers closed, dates."
    echo ""
fi
