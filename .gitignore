/target
**/*.rs.bk
*.pdb
.DS_Store

# Android build outputs
/android/.gradle/
/android/app/build/
/android/local.properties
/android/app/src/main/jniLibs/
*.apk
*.aab
*.keystore
*.jks

# Editor
.idea/
.vscode/
*.swp

# Scratch WAV intermediates from tools/gen_chiptune_music.py (script now
# uses a real tempfile.TemporaryDirectory, so this is just a safety net)
/tools/_audio_tmp/

# bacon export file consumed by bacon-ls (generated by bacon -j bacon-ls)
.bacon-locations

# Nix build outputs (nix build ./result symlinks)
/result
/result-*

# direnv layout
.direnv/

# Debug symbol bundles
*.dwp
*.dSYM/

# Profiler outputs (perf, valgrind massif, heaptrack, flamegraphs)
perf.data*
*.massif
massif.out.*
heaptrack.*
*.heaptrack
flamegraph.svg
*.collapsed

# Core dumps
/core
/core.*

# Flake app reports (generated by `nix run .#<app>`; never commit)
/reports/
/dist/

# repomap codebase map (generated by nix devshell hook; never commit)
.repomap.txt
target-lea/
